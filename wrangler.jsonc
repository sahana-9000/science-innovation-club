{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "science-innovation-club",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
